# Copy to .env and fill in. Never commit .env.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
ANTHROPIC_API_KEY=sk-ant-...

# Email fallback (Gmail): create an app password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification). Spaces in the app password are ignored.
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop
# ALERT_EMAIL_TO=you@gmail.com   # optional; defaults to SMTP_USER

# Dedicated Gmail inbox that receives the job-alert emails (read-only IMAP; enable IMAP in Gmail settings and
# use an app password, as above). Leave unset to disable the email source.
JOBMAIL_ADDRESS=your.jobmail@gmail.com
JOBMAIL_APP_PASSWORD=abcd efgh ijkl mnop
